    {
      "id": "kda-state",
      "priority": "P1",
      "title": "测量 KDA 状态收集与回写",
      "status": "代码可见额外数据搬运；瓶颈待测",
      "scope": "K3 KDA prefill / A3；保持原状态精度",
      "observation": "prefill 取 recurrent_state[state_indices].contiguous()，算子后 final_state 转 dtype 并按索引写回；布局转换有实际代码依据。",
      "proposal": "用 trace 确认 gather/copy/scatter 和算子时长；评估索引直接输入或原位输出接口，优先减少非连续状态搬运。",
      "metric": "状态搬运字节与时间；kernel 数；prefill tokens/s；最终状态最大/均方误差；长续写偏差。",
      "risk": "缓存索引复用、前缀重用与 speculative rollback 可能导致别名或写错状态；不能直接删 contiguous。",
      "refs": [
        {
          "id": "s2",
