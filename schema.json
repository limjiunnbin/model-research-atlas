{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Research Atlas data contracts",
  "description": "Root selects a document type; cross-file references are checked by scripts/build.py.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/family"
    },
    {
      "$ref": "#/$defs/architecture"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/hardware"
    },
    {
      "$ref": "#/$defs/compute"
    }
  ],
  "$defs": {
    "catalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "families"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "publisher",
              "description",
              "path",
              "updated"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "repositoryCount": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "description": "主页卡片类别标签，默认“组织研究”"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "主页卡片主题标签"
              },
              "counts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "主页卡片底部口径说明；提供时可省略 repositoryCount"
              }
            },
            "anyOf": [
              {
                "required": [
                  "repositoryCount"
                ]
              },
              {
                "required": [
                  "counts"
                ]
              }
            ]
          }
        },
        "comparisonPath": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "evidence": {
          "enum": [
            "official",
            "derived",
            "interpretation",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "const": "unknown"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "branch",
        "summary",
        "tags",
        "facts",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fact"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecturePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "auditPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "configPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "releaseDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "computePath": {
          "type": "string"
        }
      }
    },
    "family": {
      "type": "object",
      "required": [
        "id",
        "name",
        "models",
        "overview",
        "technology",
        "figures",
        "downloads",
        "reportPath",
        "scenarios"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "overview": {
          "type": "object",
          "required": [
            "title",
            "conclusion",
            "highlights"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "conclusion": {
              "type": "string"
            },
            "highlights": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "section",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            }
          }
        },
        "reportPath": {
          "type": "string"
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "caption"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "path": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            }
          }
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "text",
              "models",
              "boundary"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundary": {
                "type": "string"
              }
            }
          }
        },
        "hardwarePath": {
          "type": "string"
        },
        "computePath": {
          "type": "string"
        },
        "analysisPath": {
          "type": "string"
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": [
        "tensor_template",
        "stored_dtype",
        "stored_shape",
        "logical_shape",
        "logical_parameters_each"
      ],
      "properties": {
        "tensor_template": {
          "type": "string"
        },
        "stored_dtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "stored_shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_parameters_each": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "title",
        "count",
        "selectedCount",
        "parameters",
        "matrices"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "selectedCount": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "type": [
            "number",
            "null"
          ]
        },
        "representative": {
          "type": "boolean"
        },
        "matrices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matrix"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "group",
        "number",
        "type",
        "parameters",
        "activeLinearParameters",
        "payloadBytes",
        "modules"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "parameters": {
          "type": [
            "number",
            "null"
          ]
        },
        "activeLinearParameters": {
          "type": [
            "number",
            "null"
          ]
        },
        "payloadBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "schemaVersion",
        "modelId",
        "label",
        "scope",
        "source",
        "nodes",
        "config",
        "cache"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "modelId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "config": {
          "type": "object"
        },
        "cache": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "按适用架构明确命名缓存说明；不要求不适用的 MLA/KDA/vision 字段。"
        }
      }
    },
    "report": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "html"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "html": {
            "type": "string"
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": [
        "schemaVersion",
        "familyId",
        "updated",
        "modules",
        "platforms",
        "optimizations",
        "sources",
        "protocol",
        "versionNotes",
        "downloads"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "familyId": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "models",
              "flow",
              "meaning",
              "code",
              "hardware",
              "limit",
              "refs"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "precision",
              "support",
              "stack",
              "boundary",
              "refs"
            ]
          }
        },
        "optimizations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "priority",
              "title",
              "status",
              "scope",
              "observation",
              "proposal",
              "metric",
              "risk",
              "refs"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "url",
              "revision",
              "accessed",
              "kind"
            ]
          }
        },
        "protocol": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versionNotes": {
          "type": "array"
        },
        "downloads": {
          "type": "object",
          "required": [
            "report",
            "sources"
          ]
        }
      }
    },
    "compute": {
      "type": "object",
      "required": [
        "schemaVersion",
        "familyId",
        "snapshot",
        "models",
        "templates",
        "proofs",
        "counts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "familyId": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "nodes",
              "symbols"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "layer",
                    "group",
                    "template",
                    "parameters"
                  ]
                }
              }
            }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "modelId",
              "steps"
            ],
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "input",
                    "output",
                    "relation",
                    "tensors",
                    "apis",
                    "reference",
                    "parameters"
                  ]
                }
              }
            }
          }
        },
        "proofs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "repo",
              "revision",
              "path",
              "symbol",
              "line",
              "end",
              "sourceSha256",
              "functionSha256"
            ]
          }
        },
        "counts": {
          "type": "object"
        }
      }
    },
    "analysisReference": {
      "type": "object",
      "required": [
        "sourceId",
        "revision",
        "path",
        "line",
        "end",
        "sourceSha256",
        "rangeSha256",
        "url"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rangeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "schemaVersion",
        "familyId",
        "snapshot",
        "scope",
        "costModels",
        "cannContracts",
        "parallel",
        "mechanisms",
        "costFormulas",
        "limits",
        "counts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "familyId": {
          "const": "deepseek"
        },
        "costModels": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "revision",
              "kind",
              "context",
              "config",
              "groups",
              "mainLogicalParameters",
              "publishedWeightBytes",
              "parallelElements"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "mla",
                  "dsa",
                  "gqa",
                  "v4"
                ]
              },
              "context": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "ratio",
                    "ffn",
                    "linears",
                    "count",
                    "nodes"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "linears": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "tensor",
                          "shape",
                          "callsPerToken",
                          "proofId"
                        ],
                        "properties": {
                          "shape": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "callsPerToken": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "cannContracts": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "id",
              "revision",
              "tag",
              "claims",
              "rules",
              "limits"
            ],
            "properties": {
              "claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "apiDocument",
                    "parameter",
                    "categories",
                    "statement",
                    "reference"
                  ],
                  "properties": {
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "shape",
                          "dtype",
                          "layout",
                          "quantization",
                          "platform",
                          "condition",
                          "parameter"
                        ]
                      }
                    },
                    "reference": {
                      "$ref": "#/$defs/analysisReference"
                    }
                  }
                }
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "field",
                    "label",
                    "reference"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "enum",
                        "rank",
                        "nonempty",
                        "suffix",
                        "swiglu-axis",
                        "matmul-k"
                      ]
                    },
                    "reference": {
                      "$ref": "#/$defs/analysisReference"
                    }
                  }
                }
              }
            }
          }
        },
        "parallel": {
          "type": "object",
          "required": [
            "topics",
            "sources",
            "formulas",
            "limits"
          ],
          "properties": {
            "topics": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "summary",
                  "refs"
                ],
                "properties": {
                  "refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/analysisReference"
                    }
                  }
                }
              }
            }
          }
        },
        "mechanisms": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "references",
              "limit",
              "evidence"
            ],
            "properties": {
              "id": {
                "enum": [
                  "mla",
                  "dsa",
                  "compression",
                  "mhc",
                  "dspark"
                ]
              },
              "evidence": {
                "const": "interpretation"
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "schemaVersion",
        "snapshot",
        "families",
        "models",
        "dimensions",
        "limits"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "models": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "items": {
            "type": "object",
            "required": [
              "key",
              "familyId",
              "id",
              "name",
              "facts",
              "inputModelSha256"
            ],
            "properties": {
              "facts": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/fact"
                }
              },
              "inputModelSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
